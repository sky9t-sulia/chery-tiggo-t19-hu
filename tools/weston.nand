#!/bin/sh
#
### BEGIN INIT INFO
# Provides: weston
# Required-Start: $local_fs $remote_fs
# Required-Stop: $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

killproc() {
        pid=`/bin/pidof $1`
        [ "$pid" != "" ] && kill $pid
}

read CMDLINE < /proc/cmdline
for x in $CMDLINE; do
        case $x in
        weston=false)
		echo "Weston disabled"
		exit 0;
                ;;
        esac
done

case "$1" in
  start)
        # tiggo: stock UI - only when called by /etc/init.d/tiggo (STOCK stick or our shell gave up): TIGGO_WESTON=1.
        # S09 at boot - nothing: our shell draws by itself (fbdev), started by S08tiggo. Without S08tiggo (rollback) - stock.
        [ "$TIGGO_WESTON" = 1 ] || [ ! -f /etc/rc5.d/S08tiggo ] || exit 0

        . /etc/profile

        # This is all a nasty hack
        if test -z "$XDG_RUNTIME_DIR"; then
                export XDG_RUNTIME_DIR=/run/user/root
                mkdir --parents $XDG_RUNTIME_DIR
                chmod 0700 $XDG_RUNTIME_DIR
        fi

        export FB_MULTI_BUFFER=2

        openvt -s -- weston -i0 --log=/tmp/weston.log
		
        unset WESTON
        while [ -z "$WESTON" ]
        do
            WESTON=`pgrep -f weston-desktop-shell`
            sleep 0.2s
        done
        echo "Launching ShellApp..."
        /home/root/shell/startup.sh &
        /usr/bin/GPSService 1>/dev/null 2>&1 &
        /usr/bin/carplay.sh &
        #/usr/bin/carlife.sh &
        (sleep 12 ; /media/mtd7/applink/bin/YQ_SSPMain -platform wayland) &

  ;;

  stop)
        echo "Stopping Weston"
        killproc weston
  ;;

  restart)
	$0 stop
        sleep 1
        $0 start
  ;;

  *)
        echo "usage: $0 { start | stop | restart }"
  ;;
esac

exit 0
