# hostapd for the HU (ARM, libnl-3 from the HU firmware, built-in crypto, no OpenSSL)
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211N=y
CONFIG_CTRL_IFACE=y
CONFIG_NO_RANDOM_POOL=y
CFLAGS += -I/w/libnl-inc
LIBS += -L/w/nllib -Wl,-rpath-link,/sysroot/usr/lib
